{% extends '_base.html.twig' %}

{% block content %}
<section class="hero" id="accueil">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="eyebrow reveal">Usine du Centre Uhai Kikyo — Butembo</p>
    <h1 class="reveal">L’eau potable, pure et sûre, pour chaque famille</h1>
    <p class="hero-lead reveal">{{ site.description }}</p>
    <div class="hero-actions reveal">
      <a class="btn" href="#services">Découvrir nos services</a>
      <a class="btn btn-outline" href="#qualite">Notre engagement qualité</a>
    </div>
    <div class="hero-stats reveal" aria-label="Indicateurs">
      <div class="stat"><strong>100%</strong><span>Engagement qualité</span></div>
      <div class="stat"><strong>Potable</strong><span>Eau traitée avec soin</span></div>
      <div class="stat"><strong>Butembo</strong><span>Au service de la communauté</span></div>
    </div>
  </div>
  <div class="wave" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none"><path fill="currentColor" d="M0,64 C240,128 480,0 720,48 C960,96 1200,112 1440,64 L1440,120 L0,120 Z"></path></svg>
  </div>
</section>

<section class="section" id="apropos">
  <div class="container split">
    <div class="reveal">
      <p class="eyebrow">À propos</p>
      <h2>Une usine d’eau au service de la vie</h2>
      <p>Le Centre Uhai Kikyo œuvre à fournir une eau potable propre, saine et fiable. Notre mission est de protéger la santé des familles de Butembo grâce à une production rigoureuse, une hygiène maîtrisée et un service responsable.</p>
      <p>Chaque étape — du captage au conditionnement — est pensée pour préserver la pureté de l’eau et répondre aux besoins quotidiens des ménages, commerces et institutions.</p>
      <div class="pill-row">
        <span class="pill">Hygiène</span>
        <span class="pill">Sécurité</span>
        <span class="pill">Fiabilité</span>
        <span class="pill">Communauté</span>
      </div>
    </div>
    <div class="about-media reveal">
      <img src="https://images.unsplash.com/photo-1548839140-29a749e1cf4d?auto=format&fit=crop&w=1200&q=80" alt="Eau claire et pure" loading="lazy">
      <div class="about-card">
        <strong>Notre promesse</strong>
        <p>De l’eau traitée avec soin, pour la santé de tous.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt" id="services">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Services</p>
      <h2>Des solutions d’eau potable adaptées</h2>
      <p>Production, conditionnement et distribution d’eau potable dans le respect des bonnes pratiques d’hygiène.</p>
    </div>
    <div class="grid cards-3">
      <article class="card reveal">
        <div class="card-icon">🚰</div>
        <h3>Production d’eau potable</h3>
        <p>Traitement et production d’eau destinée à la consommation, avec un contrôle attentif à chaque étape.</p>
      </article>
      <article class="card reveal">
        <div class="card-icon">📦</div>
        <h3>Conditionnement</h3>
        <p>Mise en contenants propres pour faciliter l’usage quotidien des familles, commerces et structures locales.</p>
      </article>
      <article class="card reveal">
        <div class="card-icon">🚚</div>
        <h3>Service à la communauté</h3>
        <p>Une présence locale à Butembo pour répondre aux besoins essentiels en eau potable, avec sérieux et proximité.</p>
      </article>
    </div>
  </div>
</section>

<section class="section" id="processus">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Processus</p>
      <h2>De la source au consommateur</h2>
      <p>Un parcours maîtrisé pour garantir une eau propre, claire et sûre.</p>
    </div>
    <div class="timeline">
      <div class="step reveal"><span>1</span><div><h3>Collecte</h3><p>Prélèvement de l’eau dans des conditions contrôlées pour limiter les risques de contamination.</p></div></div>
      <div class="step reveal"><span>2</span><div><h3>Traitement</h3><p>Purification et traitement visant à rendre l’eau propre, saine et adaptée à la consommation.</p></div></div>
      <div class="step reveal"><span>3</span><div><h3>Contrôle</h3><p>Vérification de la qualité et respect des règles d’hygiène avant toute mise à disposition.</p></div></div>
      <div class="step reveal"><span>4</span><div><h3>Distribution</h3><p>Conditionnement et distribution pour apporter une eau potable fiable aux familles de Butembo.</p></div></div>
    </div>
  </div>
</section>

<section class="section section-alt" id="gestion">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Gestion</p>
      <h2>Commandes et livraisons</h2>
      <p>Optimisez le suivi des commandes, des livraisons et des opérations quotidiennes de l’usine.</p>
    </div>
    <div class="gestion-stats reveal" aria-label="Statistiques">
      <div class="gstat"><strong id="stat-commandes">0</strong><span>Commandes actives</span></div>
      <div class="gstat"><strong id="stat-livraisons">0</strong><span>Livraisons actives</span></div>
      <div class="gstat"><strong id="stat-attente">0</strong><span>En attente</span></div>
      <div class="gstat"><strong id="stat-corbeille">0</strong><span>Corbeille</span></div>
    </div>
    <div class="gestion-panel reveal">
      <div class="tabs" role="tablist" aria-label="Type de gestion">
        <button type="button" class="tab active" data-tab="commandes" role="tab" aria-selected="true">Commandes</button>
        <button type="button" class="tab" data-tab="livraisons" role="tab" aria-selected="false">Livraisons</button>
        <button type="button" class="tab" data-tab="corbeille" role="tab" aria-selected="false">Corbeille</button>
      </div>
      <div class="toolbar">
        <input type="search" id="search-input" class="input" placeholder="Rechercher client, produit, adresse…" aria-label="Rechercher">
        <select id="filter-status" class="input" aria-label="Filtrer par statut">
          <option value="">Tous les statuts</option>
          <option value="En attente">En attente</option>
          <option value="Confirmée">Confirmée</option>
          <option value="En préparation">En préparation</option>
          <option value="En livraison">En livraison</option>
          <option value="Livrée">Livrée</option>
          <option value="Annulée">Annulée</option>
        </select>
        <button type="button" class="btn btn-sm" id="btn-new">+ Nouveau</button>
      </div>
      <form id="gestion-form" class="gestion-form" novalidate>
        <input type="hidden" id="record-id">
        <input type="hidden" id="record-type" value="commande">
        <div class="form-grid">
          <div class="field"><label for="client">Client</label><input id="client" class="input" type="text" required placeholder="Nom du client"></div>
          <div class="field"><label for="telephone">Téléphone</label><input id="telephone" class="input" type="tel" placeholder="Ex: +243…"></div>
          <div class="field"><label for="produit">Produit</label><select id="produit" class="input" required>
            <option value="">Choisir…</option><option>Eau potable 20L</option><option>Eau potable 10L</option><option>Eau potable 5L</option><option>Eau potable 1.5L (pack)</option><option>Eau potable 500ml (pack)</option><option>Bidon vide</option><option>Autre</option>
          </select></div>
          <div class="field"><label for="quantite">Quantité</label><input id="quantite" class="input" type="number" min="1" value="1" required></div>
          <div class="field"><label for="date">Date</label><input id="date" class="input" type="date" required></div>
          <div class="field"><label for="statut">Statut</label><select id="statut" class="input" required>
            <option value="En attente">En attente</option><option value="Confirmée">Confirmée</option><option value="En préparation">En préparation</option><option value="En livraison">En livraison</option><option value="Livrée">Livrée</option><option value="Annulée">Annulée</option>
          </select></div>
          <div class="field field-wide"><label for="adresse">Adresse / lieu de livraison</label><input id="adresse" class="input" type="text" placeholder="Quartier, avenue, référence…"></div>
          <div class="field"><label for="livreur">Livreur / responsable</label><input id="livreur" class="input" type="text" placeholder="Nom du livreur"></div>
          <div class="field field-wide"><label for="notes">Notes</label><input id="notes" class="input" type="text" placeholder="Instructions, remarque…"></div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn" id="btn-save">Enregistrer</button>
          <button type="button" class="btn btn-secondary" id="btn-cancel">Annuler / Réinitialiser</button>
        </div>
        <p class="form-hint" id="form-hint">Mode: ajout. Sélectionnez un élément dans le tableau pour le modifier.</p>
      </form>
      <div class="table-wrap">
        <table class="data-table" aria-label="Tableau de gestion"><thead id="table-head"></thead><tbody id="table-body"></tbody></table>
        <p class="empty-state" id="empty-state" hidden>Aucun enregistrement.</p>
      </div>
    </div>
  </div>
</section>

<section class="section quality" id="qualite">
  <div class="container split">
    <div class="quality-media reveal">
      <img src="https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&w=1200&q=80" alt="Contrôle qualité en environnement industriel" loading="lazy">
    </div>
    <div class="reveal">
      <p class="eyebrow">Qualité & hygiène</p>
      <h2>La santé des familles au cœur de notre travail</h2>
      <ul class="checklist">
        <li>Priorité à la propreté et à la sécurité sanitaire.</li>
        <li>Production orientée vers une eau potable saine et fiable.</li>
        <li>Engagement constant pour la confiance des consommateurs.</li>
        <li>Service responsable au bénéfice de la communauté locale.</li>
      </ul>
      <a class="btn" href="#contact">Nous contacter</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Galerie</p>
      <h2>L’eau, source de vie</h2>
    </div>
    <div class="gallery">
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1562016600-ece13e8ba570?auto=format&fit=crop&w=900&q=80" alt="Gouttes d'eau" loading="lazy"></figure>
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1523362628745-0c100150b504?auto=format&fit=crop&w=900&q=80" alt="Eau potable en bouteille" loading="lazy"></figure>
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1611273426858-450d8e3c9fce?auto=format&fit=crop&w=900&q=80" alt="Traitement de l'eau" loading="lazy"></figure>
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1502741338009-cac2772e18bc?auto=format&fit=crop&w=900&q=80" alt="Eau fraîche" loading="lazy"></figure>
    </div>
  </div>
</section>

<section class="cta reveal">
  <div class="container cta-inner">
    <div>
      <h2>Centre Uhai Kikyo</h2>
      <p>Une eau potable propre et saine pour les familles de Butembo.</p>
    </div>
    <a class="btn btn-light" href="#top">Retour à l’accueil</a>
  </div>
</section>
{% endblock %}
